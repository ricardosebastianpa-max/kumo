# Postgres (Neon via Vercel injects DATABASE_URL automatically)
DATABASE_URL=postgres://kumo:kumo@localhost:5432/kumo
# Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Email (Resend). Without it, dev uses /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM="Kumo <hola@your-domain>"
# Tests only: path to the private seed folder (never committed)
KUMO_PRIVATE_DATA=private/data
